# Copy to apps/customer/.env.local. Use development MongoDB and Clerk values
# to run the app. CI builds with a throwaway Clerk publishable key.

# MongoDB configuration. Point both apps at the same development replica set.
MONGODB_URI=mongodb://localhost:27017/lodgeflow?replicaSet=rs0

# Clerk Authentication
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Optional local Clerk routing
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Runtime checkout and webhook credentials
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# From `stripe listen` locally, or the endpoint's signing secret in the Stripe
# dashboard. Verified by app/api/payments/webhook.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Runtime email delivery
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Optional sender overrides, shared with the admin app. Mailbox only; the
# display name remains LodgeFlow. Unset uses these approved production defaults.
# LODGEFLOW_PAYMENT_EMAIL_FROM=payments@lodgeflow.app
# LODGEFLOW_NOTIFICATION_EMAIL_FROM=notifications@lodgeflow.app

# Public origin of the site. Drives Stripe checkout success/cancel redirects,
# plus metadataBase, sitemap.ts, robots.ts and JSON-LD via config/site.ts.
# Shared metadata/checkout validation accepts a bare hostname (HTTPS), explicit
# HTTP/HTTPS, and loopback hosts (HTTP). Do not include credentials, a path, query
# or fragment, or use admin.lodgeflow.app. An explicit empty value is invalid.
# If absent, metadata defaults to https://lodgeflow.app; checkout retains the
# request origin for local/preview use. Set this explicitly for hosted checkout.
NEXT_PUBLIC_APP_URL=http://localhost:3001
