# Copy to .env.local and fill in. Every var below is required for `pnpm dev`
# and `pnpm build` unless marked optional.

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/lodgeflow

# Clerk Authentication
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Optional: Clerk URLs (defaults shown)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Optional: caps concurrent requests to the Clerk API
# CLERK_API_CONCURRENT_LIMIT=10

# Stripe Payments
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# From `stripe listen` locally, or the endpoint's signing secret in the Stripe
# dashboard. Verified by app/api/payments/webhook.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Transactional email
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Public origin of the site. Drives Stripe checkout success/cancel redirects,
# plus metadataBase, sitemap.ts, robots.ts and JSON-LD via config/site.ts.
# Include the scheme: config/site.ts normalizes a bare hostname to https://,
# but the Stripe redirect URLs are built from this value verbatim.
NEXT_PUBLIC_APP_URL=http://localhost:3002
