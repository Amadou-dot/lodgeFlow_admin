# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel
.vscode/*
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Lockfiles from other package managers. pnpm-lock.yaml is deliberately NOT
# ignored — it must be committed so installs are reproducible and transitive
# versions can't drift silently.
yarn.lock
package-lock.json
bun.lockb
.vercel
.worktrees/

# Every .env file is ignored (.env.local holds real secrets) except the
# committed template documenting which vars the app needs.
.env*
!.env.example
