# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

yarn.lock
package-lock.json
bun.lockb
/.vscode/
.vscode/settings.json

.env
.env.*
*.code
*.code-workspace

# clerk configuration (can include secrets)
/.clerk/

local/*

.playwright-mcp/*
.env*

# apps/customer keeps a committed .env.example template documenting which
# vars it needs; the blanket .env* rule above would otherwise catch it too.
!.env.example

# Git worktrees left under apps/customer (excluded from its Jest config too)
.worktrees/

# Workspace
#
# Every pattern below this point that has a `/` anywhere but the end (or a
# leading `/`) is anchored to the directory of the .gitignore that declares
# it. These lines used to live in apps/admin/.gitignore, where that anchor
# was apps/admin/ -- moving the file to the repo root re-anchored all of them
# to the root only, silently dropping per-app coverage. This block restores
# it for every such pattern above (aside from /.next/, /node_modules/, and
# tsconfig.tsbuildinfo, which the brief's Step 3 already handled).
apps/*/.next/
apps/*/node_modules/
apps/*/tsconfig.tsbuildinfo
apps/*/coverage/
apps/*/out/
apps/*/build/
apps/*/.vscode/
apps/*/.clerk/
apps/*/local/
apps/*/.playwright-mcp/
apps/*/.pnp
