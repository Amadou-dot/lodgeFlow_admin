# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

yarn.lock
package-lock.json
bun.lockb
/.vscode/
.vscode/settings.json

.env
.env.*
*.code
*.code-workspace

# clerk configuration (can include secrets)
/.clerk/

local/*

.playwright-mcp/*
.env*

# apps/customer keeps a committed .env.example template documenting which
# vars it needs; the blanket .env* rule above would otherwise catch it too.
!.env.example

# Git worktrees left under apps/customer (excluded from its Jest config too)
.worktrees/

# Workspace
apps/*/.next/
apps/*/node_modules/
apps/*/tsconfig.tsbuildinfo
